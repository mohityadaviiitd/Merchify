# Database Sharding Configuration
# Copy this to .env and fill in your RDS endpoints

# ===== DEFAULT DATABASE (Auth & System Tables) =====
POSTGRES_DB=merchify
POSTGRES_USER=merchifyuser
POSTGRES_PASSWORD=your_secure_password_here
DB_HOST=your-default-db.xxxxxxxxxx.rds.amazonaws.com
DB_PORT=5432

# ===== SHARD 0 - PRIMARY (Even user IDs) =====
SHARD_0_DB=merchify_shard_0
SHARD_0_USER=merchifyuser
SHARD_0_PASSWORD=your_secure_password_here
SHARD_0_HOST=shard-0-primary.xxxxxxxxxx.rds.amazonaws.com
SHARD_0_PORT=5432

# ===== SHARD 0 - READ REPLICA =====
SHARD_0_REPLICA_DB=merchify_shard_0
SHARD_0_REPLICA_USER=merchifyuser
SHARD_0_REPLICA_PASSWORD=your_secure_password_here
SHARD_0_REPLICA_HOST=shard-0-replica.xxxxxxxxxx.rds.amazonaws.com
SHARD_0_REPLICA_PORT=5432

# ===== SHARD 1 - PRIMARY (Odd user IDs) =====
SHARD_1_DB=merchify_shard_1
SHARD_1_USER=merchifyuser
SHARD_1_PASSWORD=your_secure_password_here
SHARD_1_HOST=shard-1-primary.xxxxxxxxxx.rds.amazonaws.com
SHARD_1_PORT=5432

# ===== SHARD 1 - READ REPLICA =====
SHARD_1_REPLICA_DB=merchify_shard_1
SHARD_1_REPLICA_USER=merchifyuser
SHARD_1_REPLICA_PASSWORD=your_secure_password_here
SHARD_1_REPLICA_HOST=shard-1-replica.xxxxxxxxxx.rds.amazonaws.com
SHARD_1_REPLICA_PORT=5432

# ===== EXISTING CONFIGURATION (Keep Your Current Settings) =====
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_s3_bucket
AWS_S3_REGION_NAME=ap-south-1

# Django
SECRET_KEY=your_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend
FRONTEND_BASE_URL=http://localhost:3000
